# Secrets - .env is generated by env-sync from Doppler; never commit any form,
# including hand-made copies and backups (patterns, not filenames, because the
# next backup will be named something else). .env.example stays tracked.
.env
.env.txt
.env.bak
.env.doppler-tmp
.env.*.bak
.env.backup*
*.bak-*

node_modules/

# All runtime output - state files, logs, dated reports - lives under var/.
# See src/core/paths.mjs. A same-named legacy file at the repo root migrates
# into var/ automatically the first time anything resolves that path.
var/
