# =========================================================================
# ENV SCHEMA - names only, no values. .env itself is GENERATED by
# `npm run env-sync` from Doppler (dev scope) and is gitignored - never
# hand-write or commit it. See scripts/env-sync.mjs and CLAUDE.md.
#
# Set the matching Doppler project name in scripts/env-sync.mjs's own
# comments/README once you've created one; the template ships with no
# project wired up, and `npm test` / `npm start` both work with none of
# these set.
# =========================================================================

# Name of this MCP server - shown in the MCP `Server` registration and
# prefixed on every stderr log line. Defaults to "<SERVER_NAME>" if unset.
# Also the sentinel value scripts/env-sync.mjs checks for in a downloaded
# Doppler payload, so keep it set once you're syncing real config.
MCP_SERVER_NAME=

# Toolset filter this process exposes (src/core/registry.mjs). Leave unset
# or "all" to expose every registered tool; set to one tool's `category`
# (e.g. "example") to run several scoped MCP client entries off one server
# file.
MCP_TOOLSET=
