# =========================================================================
# ENV SCHEMA - names only, no values. .env itself is GENERATED by
# `npm run env-sync` from Doppler (dev scope) and is gitignored - never
# hand-write or commit it. See scripts/env-sync.mjs and CLAUDE.md.
#
# Set the matching Doppler project name in scripts/env-sync.mjs's own
# comments/README once you've created one; the template ships with no
# project wired up, and `npm test` / `npm start` both work with none of
# these set.
# =========================================================================

# Name of this MCP server - shown in the MCP `Server` registration and
# prefixed on every stderr log line. Defaults to "<SERVER_NAME>" if unset.
# Also the sentinel value scripts/env-sync.mjs checks for in a downloaded
# Doppler payload, so keep it set once you're syncing real config.
MCP_SERVER_NAME=

# Toolset filter this process exposes (src/core/registry.mjs). Leave unset
# or "all" to expose every registered tool; set to one tool's `category`
# (e.g. "example") to run several scoped MCP client entries off one server
# file.
MCP_TOOLSET=

# Whether this process may cause OUTWARD effects. Defaults to TRUE (dry run)
# when unset, so a freshly cloned server cannot reach out and touch anything
# before its operator has decided that it should. In dry mode an effectful
# tool computes everything, reports what it would have done, and consumes no
# confirmation. Set to false only when you mean it.
MCP_DRY_RUN=

# How long a confirmation token stays spendable, in milliseconds. Default is
# 15 minutes, clamped to 1 hour. A token is single use and bound to the exact
# arguments it was minted for; see src/core/confirm.mjs.
MCP_CONFIRM_TTL_MS=

# Audit log rotation. MAX_BYTES is the size at which var/logs/audit.jsonl
# rolls over; KEEP_FILES is how many archives are retained. A live effect is
# refused outright when this log cannot be written, so do not point it
# somewhere unwritable.
MCP_AUDIT_MAX_BYTES=
MCP_AUDIT_KEEP_FILES=

# WIDEN-ONLY allowlists, comma separated. Each one EXTENDS an in-code default
# set and has no form that narrows or replaces it, so a malformed or empty
# value can never silently open a gate.
#
# MCP_AUDIT_REDACT_EXTRA     additional argument names to scrub before hashing
# MCP_CONFIRM_REQUIRED_EXTRA additional tools to force through the two-phase
#                            confirmation flow
MCP_AUDIT_REDACT_EXTRA=
MCP_CONFIRM_REQUIRED_EXTRA=

# Point the dotenv loader at a different file. Mainly a test hook: the suite
# uses it to stay hermetic instead of picking up a developer's real .env.
MCP_ENV_FILE=
